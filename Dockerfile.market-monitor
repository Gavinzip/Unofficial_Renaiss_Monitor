FROM python:3.12-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1
ENV SEEN_IDS_FILE=/data/seen_ids.txt

COPY requirements.market-monitor.txt /app/requirements.market-monitor.txt
RUN pip install --no-cache-dir -r /app/requirements.market-monitor.txt

COPY scripts/market_monitor.py /app/scripts/market_monitor.py
COPY scripts/market_report_vision.py /app/scripts/market_report_vision.py
COPY scripts/whitelist.txt /app/scripts/whitelist.txt

CMD ["python", "scripts/market_monitor.py"]
